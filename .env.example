# Copy to .env.local and fill in. Never commit real values.
# Read at compile time by src-tauri/build.rs (see docs/setup/google-cloud.md).
#
# Google OAuth client of type "Desktop app". For installed apps Google does not treat the
# client secret as confidential (it ships inside the app), but keep both out of the repo so
# forks use their own client.
TRACKWORTH_GOOGLE_CLIENT_ID=
TRACKWORTH_GOOGLE_CLIENT_SECRET=
